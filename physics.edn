;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document intake and archival robot performs
;; loan-file assembly, income-document scanning and physical archival (ISCO
;; 3312 credit and loans officers). Its physical work: lifting assembled loan
;; files into archive boxes on the shelf, and couriering boxes to the archive.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3312"
 :cases
 [{:id :loan-file-box-to-shelf
   :kind :manipulator
   :procedure "arm lifts a filled loan-file archive box from the assembly bench to the second archive shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 3.0
            :from [0.55 0.10] :to [0.25 0.75] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 3.0 5.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 80.0 :basis "estimate: continuous shoulder torque of a ~7 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 30.0}}
  {:id :archive-box-courier
   :kind :transport
   :procedure "courier robot carries a cart of loan-file boxes from the underwriting floor to the records archive"
   :params {:mass-kg 50.0 :payload-kg 40.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 150.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.30}
   :sweep {:param :distance-m :values [20.0 40.0 80.0 120.0 200.0]}
   :quantity :cycle-time-s
   :limit {:max 150.0 :basis "estimate: one archive run fits the 5-minute return slot between file-assembly batches, allowing for doors and a lift"}
   :boundary {:lo 10.0 :hi 400.0}}]}
